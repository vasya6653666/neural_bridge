{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws==1.6.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--read-only",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "iam-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.iam-mcp-server==1.1.0",
        "--readonly"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "well-architected-security-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "awslabs.well-architected-security-mcp-server==0.2.0",
        "well-architected-security-mcp-server"
      ],
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-documentation-mcp-server": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server==1.2.0"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}