{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rawtree",
  "version": "0.3.1",
  "description": "Use RawTree to ingest, query, and analyze event data.",
  "author": {
    "name": "RawTree",
    "url": "https://rawtree.com",
    "email": "teamrt@rawtree.com"
  },
  "keywords": [
    "rawtree",
    "analytics database",
    "database",
    "SQL",
    "dynamic columns",
    "observability",
    "logs",
    "traces",
    "metrics",
    "ingest",
    "query",
    "MCP"
  ],
  "license": "Apache-2.0",
  "homepage": "https://rawtree.com",
  "repository": "https://github.com/rawtreedb/agent-skills",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "RawTree",
        "shortDescription": "Query and analyze event data",
        "longDescription": "Explore your RawTree databases, ingest JSON events, and analyze logs, traces, and metrics with SQL. Inspect evolving data, work with nested fields, investigate errors, and improve query performance. Connect your RawTree account to work with your data.",
        "developerName": "RawTree",
        "category": "Developer Tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://rawtree.com",
        "privacyPolicyURL": "https://www.tinybird.co/privacy",
        "termsOfServiceURL": "https://www.tinybird.co/terms-and-conditions",
        "defaultPrompt": [
          "Investigate recent errors in my RawTree logs",
          "Ingest JSON events into a RawTree table",
          "Help optimize a slow RawTree SQL query"
        ],
        "composerIcon": "./icon.png",
        "logo": "./icon.png"
      }
    }
  }
}
